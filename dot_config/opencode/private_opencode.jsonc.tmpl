{{- $public := include ".data/pi/agent/mcp.json" | mustFromJson -}}
{{- $servers := deepCopy (index $public "mcpServers" | default dict) -}}
{{- $privatePath := joinPath .chezmoi.sourceDir ".data-private/pi/agent/mcp.json" -}}
{{- if stat $privatePath -}}
{{-   $private := include ".data-private/pi/agent/mcp.json" | mustFromJson -}}
{{-   range $name, $server := (index $private "mcpServers" | default dict) -}}
{{-     $_ := set $servers $name (deepCopy $server) -}}
{{-   end -}}
{{- end -}}
{{- $mcp := dict -}}
{{- range $name, $server := $servers -}}
{{-   $enabled := true -}}
{{-   if and (hasKey $server "enabled") (eq (index $server "enabled") false) -}}
{{-     $enabled = false -}}
{{-   end -}}
{{-   if hasKey $server "url" -}}
{{-     $entry := dict "type" "remote" "url" (index $server "url") "enabled" $enabled -}}
{{-     if hasKey $server "headers" -}}
{{-       $_ := set $entry "headers" (deepCopy (index $server "headers")) -}}
{{-     end -}}
{{-     if hasKey $server "oauth" -}}
{{-       $oauth := index $server "oauth" -}}
{{-       $openCodeOAuth := dict -}}
{{-       range $key := list "clientId" "clientSecret" "scope" -}}
{{-         if hasKey $oauth $key -}}
{{-           $_ := set $openCodeOAuth $key (index $oauth $key) -}}
{{-         end -}}
{{-       end -}}
{{-       if hasKey $oauth "callbackUrl" -}}
{{-         $_ := set $openCodeOAuth "redirectUri" (index $oauth "callbackUrl") -}}
{{-       else if hasKey $oauth "callbackPort" -}}
{{-         $_ := set $openCodeOAuth "redirectUri" (printf "http://127.0.0.1:%v/callback" (index $oauth "callbackPort")) -}}
{{-       end -}}
{{-       $_ := set $entry "oauth" $openCodeOAuth -}}
{{-     end -}}
{{-     if hasKey $server "timeout" -}}
{{-       $_ := set $entry "timeout" (mulf (index $server "timeout") 1000) -}}
{{-     end -}}
{{-     $_ := set $mcp $name $entry -}}
{{-   else if hasKey $server "command" -}}
{{-     $command := list (index $server "command") -}}
{{-     if hasKey $server "args" -}}
{{-       $command = concat $command (index $server "args") -}}
{{-     end -}}
{{-     $entry := dict "type" "local" "command" $command "enabled" $enabled -}}
{{-     if hasKey $server "cwd" -}}
{{-       $_ := set $entry "cwd" (index $server "cwd") -}}
{{-     end -}}
{{-     if hasKey $server "env" -}}
{{-       $_ := set $entry "environment" (deepCopy (index $server "env")) -}}
{{-     end -}}
{{-     if hasKey $server "timeout" -}}
{{-       $_ := set $entry "timeout" (mulf (index $server "timeout") 1000) -}}
{{-     end -}}
{{-     $_ := set $mcp $name $entry -}}
{{-   else -}}
{{-     fail (printf "MCP server %q has no OpenCode-compatible command or URL" $name) -}}
{{-   end -}}
{{- end -}}
{{ dict
  "$schema" "https://opencode.ai/config.json"
  "model" "github-copilot/gpt-6-sol"
  "mcp" $mcp
  | toPrettyJson
}}
