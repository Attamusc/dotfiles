{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

source /tmp/chezmoi-utils.sh
printf "${green}[01 - homebrew] ${reset}"

{{ if or (lt 0 (atoi (env "SCRIPTS_START_AT"))) (env "SKIP_HOMEBREW_SETUP") -}}
echo "Skip installing Homebrew"
exit 0
{{ else -}}
echo "Install Homebrew"
{{ end -}}

if command -v brew >/dev/null 2>&1; then
  echo "Homebrew already installed, skipping."
  exit 0
fi

NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

if [ -x /opt/homebrew/bin/brew ]; then
  /opt/homebrew/bin/brew --version
elif [ -x /usr/local/bin/brew ]; then
  /usr/local/bin/brew --version
else
  echo "Homebrew installer completed without a usable brew executable." >&2
  exit 1
fi
{{- end }}
