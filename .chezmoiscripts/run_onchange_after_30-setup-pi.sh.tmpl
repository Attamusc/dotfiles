#!/bin/bash

set -euo pipefail

# Public Pi settings SHA-256: {{ include ".data/pi/agent/settings.json" | sha256sum }}
# Private Pi settings SHA-256: {{ $private := joinPath .chezmoi.sourceDir ".data-private/pi/agent/settings.json" }}{{ if stat $private }}{{ include ".data-private/pi/agent/settings.json" | sha256sum }}{{ else }}absent{{ end }}
printf '[30 - Pi packages] Reconcile configured packages\n'

command -v gh >/dev/null 2>&1 || {
  echo "GitHub CLI is required to reconcile private Pi packages." >&2
  exit 1
}
gh auth status --hostname github.com >/dev/null
local_git_config="$HOME/.gitconfig.local"
if [[ ! -e "$local_git_config" ]]; then
  install -m 600 /dev/null "$local_git_config"
fi
chmod 600 "$local_git_config"
GIT_CONFIG_GLOBAL="$local_git_config" gh auth setup-git

{{ if eq .chezmoi.os "darwin" -}}
if [ -x /opt/homebrew/bin/brew ]; then
  brew=/opt/homebrew/bin/brew
elif [ -x /usr/local/bin/brew ]; then
  brew=/usr/local/bin/brew
else
  echo "Homebrew is required to resolve Pi." >&2
  exit 1
fi
brew_prefix=$("$brew" --prefix)
pi_bin="$brew_prefix/bin/pi"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") (eq .chezmoi.osRelease.versionID "44") -}}
mise_bin="$HOME/.local/bin/mise"
config="$HOME/.config/mise/config.toml"
[[ -x "$mise_bin" && -f "$config" ]] || {
  echo "mise must install Pi before package reconciliation." >&2
  exit 1
}
pi_bin=$(MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" which pi)
{{ else -}}
echo "Unsupported platform reached Pi setup." >&2
exit 1
{{ end -}}

[[ -x "$pi_bin" ]] || {
  echo "Pi executable is missing." >&2
  exit 1
}

{{ if eq .chezmoi.os "darwin" -}}
"$pi_bin" --version
GIT_TERMINAL_PROMPT=0 "$pi_bin" update --extensions
{{ else -}}
MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- pi --version
GIT_TERMINAL_PROMPT=0 MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- pi update --extensions
{{ end -}}
printf '[30 - Pi packages] Configured packages reconciled\n'
