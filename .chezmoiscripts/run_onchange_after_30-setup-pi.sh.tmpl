#!/bin/bash

set -euo pipefail

# Public Pi settings SHA-256: {{ include ".data/pi/agent/settings.json" | sha256sum }}
# Private Pi settings SHA-256: {{ $private := joinPath .chezmoi.sourceDir ".data-private/pi/agent/settings.json" }}{{ if stat $private }}{{ include ".data-private/pi/agent/settings.json" | sha256sum }}{{ else }}absent{{ end }}
printf '[30 - Pi integration] Reconcile pinned Git packages and Herdr integration\n'

command -v gh >/dev/null 2>&1 || {
  echo "GitHub CLI is required to reconcile private Pi packages." >&2
  exit 1
}
gh auth status --hostname github.com >/dev/null
local_git_config="$HOME/.gitconfig.local"
if [[ ! -e "$local_git_config" ]]; then
  install -m 600 /dev/null "$local_git_config"
fi
chmod 600 "$local_git_config"
GIT_CONFIG_GLOBAL="$local_git_config" gh auth setup-git

{{ if eq .chezmoi.os "darwin" -}}
if [ -x /opt/homebrew/bin/brew ]; then
  brew=/opt/homebrew/bin/brew
elif [ -x /usr/local/bin/brew ]; then
  brew=/usr/local/bin/brew
else
  echo "Homebrew is required to resolve Herdr." >&2
  exit 1
fi
brew_prefix=$("$brew" --prefix)
mise_prefix=$("$brew" --prefix mise)
mise_bin="$mise_prefix/bin/mise"
herdr_bin="$brew_prefix/bin/herdr"
{{ else if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") (eq .chezmoi.osRelease.versionID "44") -}}
mise_bin="$HOME/.local/bin/mise"
{{ else -}}
echo "Unsupported platform reached Pi setup." >&2
exit 1
{{ end -}}

# Resolve from HOME, not a project-local mise configuration.
cd "$HOME"
config="$HOME/.config/mise/config.toml"
[[ -x "$mise_bin" && -f "$config" ]] || {
  echo "mise must install Pi before package reconciliation." >&2
  exit 1
}
pi_bin=$(MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" which pi)
[[ -x "$pi_bin" ]] || {
  echo "Pi executable is missing." >&2
  exit 1
}
{{ if eq .chezmoi.os "darwin" -}}
[[ -x "$herdr_bin" ]] || {
  echo "Herdr executable is missing." >&2
  exit 1
}
{{ end -}}

# Leave unpinned checkouts and their local lockfiles to a separately approved update.
pinned_git_packages=$(
  python3 - "$HOME/.pi/agent/settings.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as settings_file:
    for entry in json.load(settings_file)["packages"]:
        source = entry if isinstance(entry, str) else entry["source"]
        _, separator, ref = source.rsplit("/", 1)[-1].rpartition("@")
        if source.startswith("git:") and separator and ref:
            if "\n" in source:
                raise ValueError("package source contains a newline")
            print(source)
PY
)
[[ -n "$pinned_git_packages" ]] || {
  echo "No pinned Git packages found in Pi settings." >&2
  exit 1
}

MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- pi --version
while IFS= read -r package; do
  GIT_TERMINAL_PROMPT=0 MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- pi update --extension "$package" </dev/null
done <<< "$pinned_git_packages"
{{ if eq .chezmoi.os "darwin" -}}
MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- "$herdr_bin" integration install pi
{{ else -}}
MISE_GLOBAL_CONFIG_FILE="$config" "$mise_bin" exec -- herdr integration install pi
{{ end -}}
printf '[30 - Pi integration] Pinned Git packages reconciled; Herdr-managed Pi integration installed\n'
