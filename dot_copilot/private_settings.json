{
  "renderMarkdown": true,
  "theme": "auto",
  "logLevel": "all",
  "allowedUrls": [
    "https://docs.github.com"
  ],
  "enabledPlugins": {
    "slack-mcp@github-slack-mcp": true
  },
  "model": "gpt-5.6-sol",
  "subagents": {
    "agents": {
      "advisor": {
        "model": "claude-opus-5",
        "effortLevel": "high",
        "contextTier": "inherit"
      },
      "planner": {
        "model": "gpt-5.6-sol",
        "effortLevel": "high",
        "contextTier": "inherit"
      },
      "spec": {
        "model": "gpt-5.6-sol",
        "effortLevel": "high",
        "contextTier": "inherit"
      }
    }
  },
  "extraKnownMarketplaces": {
    "github-slack-mcp": {
      "source": {
        "source": "github",
        "repo": "github/copilot-slack-mcp"
      }
    }
  }
}
