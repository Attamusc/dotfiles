#!/usr/bin/env python3
"""Install one private, SHA-pinned task package into an immutable owned prefix."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def digest(data):
    return hashlib.sha256(data).hexdigest()


def inventory(root):
    result = {}
    for file in sorted(root.rglob('*')):
        name = file.relative_to(root).as_posix()
        if name == '.installed-release.json':
            continue
        if file.is_symlink():
            if not file.resolve().is_relative_to(root.resolve()) or not file.exists():
                raise ValueError('package symlink escapes prefix or is broken')
            result[name] = {'link': os.readlink(file)}
        elif file.is_file():
            result[name] = {'sha256': digest(file.read_bytes()), 'mode': file.stat().st_mode & 0o777}
        elif file.is_dir():
            result[name] = {'directory': True}
        else:
            raise ValueError('nonregular installed state')
    return result


def install():
    home = Path.home()
    pin_file = home / '.pi/agent/extensions/todos/package-pin.json'
    pin = json.loads(pin_file.read_text())
    if (pin.get('repository') != 'Attamusc/agent-tasks'
            or not re.fullmatch(r'\d+\.\d+\.\d+', pin.get('version', ''))
            or pin.get('tag') != 'v' + pin['version']
            or pin.get('asset') != 'attamusc-agent-tasks-' + pin['version'] + '.tgz'
            or not re.fullmatch(r'[a-f0-9]{64}', pin.get('sha256', ''))):
        raise ValueError('invalid task release pin')
    if pin.get('published') is not True:
        raise ValueError('task release is unpublished; coordinator rollout approval required')
    parent = home / '.local/share/pi-agent-tasks'
    target = parent / pin['sha256']
    for item in [home / '.local', home / '.local/share', parent, target]:
        if item.is_symlink() or (item.exists() and not item.is_dir()):
            raise ValueError('refusing install path collision or symlink')
    if target.exists():
        marker = target / '.installed-release.json'
        if marker.is_symlink() or not marker.is_file():
            raise ValueError('unowned task prefix collision')
        receipt = json.loads(marker.read_text())
        if any(receipt.get(k) != pin[k] for k in ['repository', 'version', 'sha256']) or receipt.get('files') != inventory(target):
            raise ValueError('modified or unexpected task prefix state')
        print('Task package already installed and verified: ' + pin['version'])
        return

    def gh(*args):
        return subprocess.run(['gh', *args], check=True, capture_output=True, text=True, timeout=120).stdout

    gh('auth', 'status', '--hostname', 'github.com')
    if gh('repo', 'view', pin['repository'], '--json', 'isPrivate', '--jq', '.isPrivate').strip() != 'true':
        raise ValueError('refusing nonprivate task repository')
    parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.task-install-', dir=parent) as work:
        work = Path(work)
        gh('release', 'download', pin['tag'], '--repo', pin['repository'], '--pattern', pin['asset'], '--dir', str(work))
        archive = work / pin['asset']
        if digest(archive.read_bytes()) != pin['sha256']:
            raise ValueError('private task release SHA256 verification failed')
        staged = work / 'prefix'
        subprocess.run(['npm', 'install', '--prefix', str(staged), '--cache', str(work / 'empty-cache'),
                        '--offline', '--ignore-scripts', '--no-audit', '--fund=false', '--package-lock=false', str(archive)], check=True, timeout=120)
        manifest = json.loads((staged / 'node_modules/@attamusc/agent-tasks/package.json').read_text())
        if manifest.get('name') != '@attamusc/agent-tasks' or manifest.get('version') != pin['version'] or manifest.get('private') is not True:
            raise ValueError('unexpected task package identity')
        for entry in ['core', 'mcp']:
            (staged / (entry + '.mjs')).write_text("export * from '@attamusc/agent-tasks/" + entry + "';\n")
        subprocess.run(['node', '--input-type=module', '-e',
                        "const c=await import('./core.mjs'); const m=await import('./mcp.mjs'); if(typeof c.executeTask!=='function'||typeof c.breakStaleLock!=='function'||typeof m.startTaskMcpServer!=='function')process.exit(1);"], cwd=staged, check=True, timeout=30)
        receipt = {k: pin[k] for k in ['repository', 'version', 'sha256']}
        receipt['files'] = inventory(staged)
        (staged / '.installed-release.json').write_text(json.dumps(receipt, sort_keys=True) + '\n')
        # Never replace an existing prefix, even if another installer raced us.
        if target.exists() or target.is_symlink():
            raise ValueError('task prefix appeared during installation')
        staged.rename(target)
    print('Installed and verified private task package: ' + pin['version'])


if __name__ == '__main__':
    try:
        install()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f'Task package installation stopped: {error}', file=sys.stderr)
        raise SystemExit(1)
